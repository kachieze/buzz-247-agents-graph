{
  "family": "agent-plane-alpha",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "4096",
  "memory": "16384",
  "runtimePlatform": { "cpuArchitecture": "X86_64", "operatingSystemFamily": "LINUX" },
  "ephemeralStorage": { "sizeInGiB": 60 },
  "volumes": [
    {
      "name": "agent-efs",
      "efsVolumeConfiguration": {
        "fileSystemId": "fs-EXAMPLE",
        "transitEncryption": "ENABLED",
        "rootDirectory": "/"
      }
    }
  ],
  "containerDefinitions": [
    {
      "name": "agent",
      "image": "ACCOUNT.dkr.ecr.us-east-1.amazonaws.com/agent-plane/runtime:TAG",
      "essential": true,
      "environment": [
        { "name": "AGENT_ID", "value": "alpha" },
        { "name": "EFS_ROOT", "value": "/agents" },
        { "name": "BUZZ_RELAY_URL", "value": "wss://relay.example.invalid" },
        { "name": "BUZZ_ACP_AGENT_COMMAND", "value": "cursor-agent" },
        { "name": "BUZZ_ACP_AGENT_ARGS", "value": "acp" },
        { "name": "BUZZ_ACP_AGENTS", "value": "1" },
        { "name": "BUZZ_ACP_RESPOND_TO", "value": "anyone" },
        { "name": "BUZZ_ACP_MCP_COMMAND", "value": "/opt/mcp/server.mjs" }
      ],
      "secrets": [
        { "name": "BUZZ_PRIVATE_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT:secret:agent-plane/alpha/nsec" },
        { "name": "CURSOR_API_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT:secret:agent-plane/alpha/cursor" }
      ],
      "mountPoints": [
        { "sourceVolume": "agent-efs", "containerPath": "/agents", "readOnly": false }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/agent-plane/alpha",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "agent"
        }
      }
    },
    {
      "name": "alloy",
      "image": "grafana/alloy:v1.8.3",
      "essential": false,
      "environment": [
        { "name": "GRAFANA_CLOUD_OTLP_ENDPOINT", "value": "https://otlp-gateway-prod-us-east-0.grafana.net/otlp" }
      ]
    }
  ]
}
