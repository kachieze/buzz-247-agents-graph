# Copy to terraform.tfvars (gitignored). Never put nsecs, PEMs, or tokens here.
aws_region   = "us-east-1"
name_prefix  = "agent-plane"
image_uri    = "111111111111.dkr.ecr.us-east-1.amazonaws.com/agent-plane/runtime:changeme"
relay_enabled = true
# Leave empty for lab: ALB HTTP :80, in-stack relay/agents use ws:// on ALB DNS.
# Add ACM (and relay_hostname for public DNS) before switching to wss://.
relay_acm_certificate_arn = ""
relay_hostname            = ""
create_dns                = false
relay_owner_pubkey        = ""
github_org                = "kachieze"
github_repo               = "buzz-247-agents-graph"
github_auth_mode          = "app"
grafana_otlp_endpoint     = ""

# Example identities. Apply still works with agents = {}.
agents = {
  alpha = {
    secret_name_nsec = "agent-plane/alpha/nsec"
    efs_subdir       = "alpha"
    cpu              = 4096
    memory           = 16384
    respond_to       = "anyone"
    # Optional cheaper Cursor model slug; omit to use the service-account default.
    # cursor_model   = "composer-2"
  }
  beta = {
    secret_name_nsec = "agent-plane/beta/nsec"
    efs_subdir       = "beta"
    cpu              = 4096
    memory           = 16384
    respond_to       = "anyone"
  }
}
